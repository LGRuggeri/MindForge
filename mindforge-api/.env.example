NODE_ENV=development
PORT=3000

# Postgres local com a extensão pgvector habilitada
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindforge

# Modelo de embedding — dimensão precisa bater com EMBEDDING_DIMENSIONS
# em src/database/schema/conteudos.schema.ts
EMBEDDING_MODEL=text-embedding-3-small

# Chave da API de LLM usada pelos agentes (Planner, Researcher, Synthesizer,
# Teacher, Evaluator, Reviewer)
LLM_API_KEY=

# Modelo de chat usado pelos agentes (OpenCode Go)
LLM_MODEL=grok-4.5

# URL base da API OpenCode Go (compatível com OpenAI)
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Provedor de embeddings usado pela Biblioteca Viva. OPCIONAL — se omitido,
# usa LLM_API_KEY/OPENAI_BASE_URL. Necessário quando o provedor de chat
# (ex: OpenCode Go) NÃO expõe o endpoint /embeddings — nesse caso, aponte
# para um provedor real (OpenAI oficial, Ollama local, etc):
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Provedor de busca web: 'duckduckgo' (scraping gratuito), 'api' (genérico Bearer)
# ou 'serper' (usa o header X-API-KEY).
# Para 'api'/'serper', configure SEARCH_API_URL e SEARCH_API_KEY.
SEARCH_PROVIDER=duckduckgo
# SEARCH_API_URL=https://google.serper.dev/search
# SEARCH_API_KEY=...

# Fallback de provedores LLM compatíveis com OpenAI. Listas separadas por vírgula,
# na mesma ordem. Útil quando o provedor principal atinge limite de uso.
# LLM_FALLBACK_BASE_URLS=https://api.groq.com/openai/v1,http://localhost:11434/v1
# LLM_FALLBACK_API_KEYS=groq-key,ollama-key
# LLM_FALLBACK_MODELS=llama3-70b-8192,llama3.1

# URL do frontend para CORS. O padrão é http://localhost:3001.
# FRONTEND_URL=http://localhost:3001
