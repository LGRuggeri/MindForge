NODE_ENV=development
PORT=3000

# Postgres local com a extensão pgvector habilitada
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mindforge

# Modelo de embedding — dimensão precisa bater com EMBEDDING_DIMENSIONS
# em src/database/schema/conteudos.schema.ts
EMBEDDING_MODEL=text-embedding-3-small

# Chave da API de LLM usada pelos agentes (Planner, Researcher, Synthesizer,
# Teacher, Evaluator, Reviewer)
LLM_API_KEY=

# Modelo de chat usado pelos agentes (OpenCode Go)
LLM_MODEL=grok-4.5

# URL base da API OpenCode Go (compatível com OpenAI)
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Provedor de embeddings usado pela Biblioteca Viva. OPCIONAL — se omitido,
# usa LLM_API_KEY/OPENAI_BASE_URL. Necessário quando o provedor de chat
# (ex: OpenCode Go) NÃO expõe o endpoint /embeddings — nesse caso, aponte
# para um provedor real (OpenAI oficial, Ollama local, etc):
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Provedor de busca web: 'duckduckgo' (scraping gratuito), 'api' (genérico Bearer)
# ou 'serper' (usa o header X-API-KEY).
# Para 'api'/'serper', configure SEARCH_API_URL e SEARCH_API_KEY.
SEARCH_PROVIDER=duckduckgo
# SEARCH_API_URL=https://google.serper.dev/search
# SEARCH_API_KEY=...

# Fallback de provedores LLM compatíveis com OpenAI. Listas separadas por vírgula,
# na mesma ordem. Útil quando o provedor principal atinge limite de uso.
# LLM_FALLBACK_BASE_URLS=https://api.groq.com/openai/v1,http://localhost:11434/v1
# LLM_FALLBACK_API_KEYS=groq-key,ollama-key
# LLM_FALLBACK_MODELS=llama3-70b-8192,llama3.1

# URL do frontend para CORS. O padrão é http://localhost:3001.
# FRONTEND_URL=http://localhost:3001

# --- Multimodalidade (módulo midia) ---
# Geração de imagens ilustrativas do Synthesizer via Gemini free tier.
# gemini-3.6-flash (modelo de chat acima) é TEXTO-ONLY — imagem exige um
# model ID da família de imagem. A Google renomeia esses modeles com
# frequência; se a geração falhar com 404, liste os modelos vigentes em:
#   GET {IMAGE_BASE_URL}/models?key=$LLM_API_KEY
# e ajuste IMAGE_MODEL.
# IMAGE_API_KEY é OPCIONAL e só pode ser omitida quando o provedor de chat JÁ
# É o Gemini (OPENAI_BASE_URL apontando para generativelanguage.googleapis.com)
# — nesse caso a geração de imagem reutiliza LLM_API_KEY. Com qualquer outro
# provedor de chat, IMAGE_API_KEY é OBRIGATÓRIA: sem ela a API recusa subir,
# para não enviar a chave de outro provedor ao Google por engano.
# IMAGE_MODEL=gemini-3.1-flash-image
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Áudio de pronúncia (tutor/exercícios) via Edge-TTS: gratuito, sem chave,
# 322 vozes neurais em 45+ idiomas. Falhas caem em 503 com mensagem clara.
# AUDIO_PROVIDER=edge-tts

# Cache local das mídias geradas (cada mídia é gerada 1x e servida do disco).
# MIDIA_DIR=./data/midias

# URL pública da API para links de imagem no Markdown do conteúdo gerado.
# API_PUBLIC_URL=http://localhost:3000
